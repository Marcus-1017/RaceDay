@model ManageVm
@{ ViewData["Title"] = "Manage " + Model.Event.EventName; }
<a asp-action="Events" class="btn btn-link ps-0">&larr; Back to events</a>
<h1>@Model.Event.EventName</h1>
<p class="text-muted">@Model.Event.EventDate.ToString("d MMM yyyy") - @Model.Event.Location</p>

<div class="card p-4 mb-4">
    <h4>Categories</h4>
    <ul class="list-group mb-3">
        @foreach (var c in Model.Categories)
        {
            <li class="list-group-item">@c.CategoryName</li>
        }
        @if (!Model.Categories.Any())
        {
            <li class="list-group-item text-muted">No categories yet.</li>
        }
    </ul>
    <form asp-action="AddCategory" method="post" class="d-flex gap-2">
        <input type="hidden" name="eventId" value="@Model.Event.EventID" />
        <input name="categoryName" class="form-control" placeholder="e.g. Under 20, Senior, 10km" required />
        <button class="btn btn-primary">Add</button>
    </form>
</div>

<div class="card p-4">
    <h4>Enrolments and results</h4>
    @if (!Model.Enrolments.Any())
    {
        <p class="text-muted mb-0">No participants have enrolled yet.</p>
    }
    else
    {
        <table class="table align-middle">
            <thead><tr><th>Participant</th><th>Category</th><th>Status</th><th>Capture result</th></tr></thead>
            <tbody>
                @foreach (var e in Model.Enrolments)
                {
                    <tr>
                        <td>@e.ParticipantName</td>
                        <td>@e.CategoryName</td>
                        <td><partial name="_Status" model="e.EnrolmentStatus" /></td>
                        <td>
                            <form asp-action="CaptureResult" method="post" class="d-flex gap-2">
                                <input type="hidden" name="eventId" value="@Model.Event.EventID" />
                                <input type="hidden" name="enrolmentId" value="@e.EnrolmentID" />
                                <input name="finishTime" class="form-control form-control-sm" placeholder="hh:mm:ss" required />
                                <input name="finishPosition" type="number" min="1" class="form-control form-control-sm" placeholder="Pos" required />
                                <button class="btn btn-sm btn-primary">Save</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>