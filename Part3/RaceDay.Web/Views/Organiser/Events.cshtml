@model List<EventItem>
@{ ViewData["Title"] = "My Events"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">My Events</h1>
    <a asp-action="EventForm" class="btn btn-primary">Create event</a>
</div>
<div class="card">
    <table class="table mb-0 align-middle">
        <thead><tr><th>Name</th><th>Date</th><th>Location</th><th>Distance</th><th>Type</th><th></th></tr></thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.EventName</td>
                    <td>@e.EventDate.ToString("d MMM yyyy")</td>
                    <td>@e.Location</td>
                    <td>@(e.Distance?.ToString("0.##") ?? "-") km</td>
                    <td><span class="badge bg-dark">@e.EventType</span></td>
                    <td class="text-end">
                        <a asp-action="Manage" asp-route-id="@e.EventID" class="btn btn-sm btn-primary">Manage</a>
                        <a asp-action="EventForm" asp-route-id="@e.EventID" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="DeleteEvent" asp-route-id="@e.EventID" method="post" class="d-inline" onsubmit="return confirm('Delete this event?');">
                            <button class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>