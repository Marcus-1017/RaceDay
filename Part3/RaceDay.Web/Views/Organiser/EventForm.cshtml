@model EventFormVm
@{ ViewData["Title"] = Model.EventID == 0 ? "Create Event" : "Edit Event"; }
<h1>@ViewData["Title"]</h1>
<div class="card p-4">
    <form asp-action="EventForm" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <input type="hidden" asp-for="EventID" />
        <div class="mb-3"><label asp-for="EventName" class="form-label"></label><input asp-for="EventName" class="form-control" /></div>
        <div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
        <div class="row">
            <div class="col-md-4 mb-3"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" type="date" class="form-control" /></div>
            <div class="col-md-4 mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" /></div>
            <div class="col-md-4 mb-3"><label asp-for="Distance" class="form-label">Distance (km)</label><input asp-for="Distance" type="number" step="0.01" class="form-control" /></div>
        </div>
        <div class="mb-3">
            <label asp-for="EventType" class="form-label"></label>
            <select asp-for="EventType" class="form-select">
                <option value="Run">Run</option>
                <option value="Walk">Walk</option>
                <option value="Cycle">Cycle</option>
            </select>
        </div>
        <button class="btn btn-primary">Save event</button>
        <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>