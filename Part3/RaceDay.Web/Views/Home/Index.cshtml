@{ ViewData["Title"] = "Welcome"; }
<div class="hero text-center">
    <h1 class="display-3 text-white">RACEDAY</h1>
    <p class="lead">Find your next run, walk or ride across South Africa. Enter in seconds and track every finish.</p>
    <a asp-controller="Auth" asp-action="Register" class="btn btn-primary btn-lg me-2">Join RaceDay</a>
    <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-light btn-lg">Login</a>
</div>
